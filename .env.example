# Copy to .env and fill in. Never commit the real .env (see .gitignore).
# CF_ = Context Fabric.

# --- Runtime mode ---
# fixture: connectors read from fixtures/, no network calls, no credentials needed.
# live: connectors call real vendor APIs using the credentials below.
CF_MODE=fixture

# --- Database ---
# Postgres is the primary/production backend. SQLite is also supported —
# zero-install, no server to run — for local/demo use:
#   CF_DATABASE_URL=sqlite+aiosqlite:///./context_fabric.db
# Known SQLite tradeoff: no pg_trgm-equivalent, so the typo-tolerant search
# tier only sees whatever ILIKE already matched (see ADR-010's dual-backend
# note) — everything else (sync, search, semantic search, the query
# language) works identically on both.
CF_DATABASE_URL=postgresql+psycopg://context_fabric:context_fabric@localhost:5432/context_fabric

# --- Secrets-at-rest key for encrypted connector credentials (Fernet, 32 url-safe base64 bytes) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CF_SECRET_KEY=

# --- Migrations ---
# Off by default: `make migrate` (alembic upgrade head) is the documented
# manual step. Set to true only if you deliberately want the container's
# own entrypoint (scripts/docker-entrypoint.sh) to run migrations before
# starting the API on every boot — it fails the container start (rather
# than serving against a half-migrated schema) if the migration itself
# fails, but this is still a schema-changing step tied to container
# lifecycle, so opt in deliberately, not by default.
CF_AUTO_MIGRATE=false

# --- API / MCP ---
CF_API_HOST=0.0.0.0
CF_API_PORT=8000
CF_MCP_HTTP_PORT=8100
CF_LOG_LEVEL=INFO
CF_LOG_FORMAT=json

# --- CORS (UI dev server) ---
CF_CORS_ORIGINS=http://localhost:5173

# --- Ollama (enrichment/ — local LLM abstracts + keywords for Confluence
# search (ADR-010), and ADR-011's inferred document relationships) ---
# Entirely optional: when unreachable, enrichment simply fails per
# document/page (logged, counted, skipped) rather than breaking sync or
# the API — nothing else depends on this being set.
# Running Ollama directly on this machine: `ollama pull llama3.2:1b` (or
# set your own model below), leave the default below as-is.
# Running via `docker compose --profile llm up -d` (docker-compose.yml's
# `ollama` service) instead: point this at the in-compose hostname —
#   CF_OLLAMA_BASE_URL=http://ollama:11434
CF_OLLAMA_BASE_URL=http://localhost:11434
CF_OLLAMA_MODEL=llama3.2:1b
CF_OLLAMA_EMBED_MODEL=nomic-embed-text

# =========================================================================
# Live connector credentials — only required when CF_MODE=live.
# Leave blank in fixture mode. NEVER commit real values.
# =========================================================================

# --- Azure DevOps ---
# CF_ADO_ORG_URL=https://dev.azure.com/your-org
# CF_ADO_PAT=

# --- GitHub ---
# CF_GITHUB_APP_ID=
# CF_GITHUB_APP_PRIVATE_KEY_PATH=
# CF_GITHUB_TOKEN=
